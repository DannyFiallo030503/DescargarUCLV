{
  "name": "uclv-media",
  "description": "Aplicación local para navegar y descargar contenido de visuales.uclv.cu",
  "desktopName": "Descargar UCLV",
  "author": "Descargar UCLV",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"npm:gateway\" \"npm:dev:ui\"",
    "dev:ui": "vite --host 127.0.0.1",
    "gateway": "node server/gateway.mjs",
    "gateway:remote": "node server/remote-gateway.mjs",
    "gateway:mobile": "concurrently -k \"npm:gateway\" \"npm:gateway:remote\"",
    "start": "node server/gateway.mjs",
    "build": "tsc -b && vite build",
    "desktop:run": "npm run build && electron .",
    "desktop:linux": "npm run build && electron-builder --linux deb",
    "desktop:linux:dir": "npm run build && electron-builder --linux dir",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run --config vitest.stress.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.1",
    "fuse.js": "^7.5.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.66.0",
    "parse5": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "rimraf": {
      "glob": "14.0.3"
    }
  },
  "build": {
    "appId": "cu.uclv.descargar",
    "productName": "Descargar-UCLV",
    "directories": { "output": "release" },
    "files": ["desktop/**/*.mjs", "package.json"],
    "extraResources": [
      { "from": "dist", "to": "dist", "filter": ["**/*"] },
      { "from": "server", "to": "server", "filter": ["**/*"] },
      { "from": "src/domain/apache-index.mjs", "to": "src/domain/apache-index.mjs" },
      { "from": "node_modules/parse5", "to": "node_modules/parse5", "filter": ["**/*"] },
      { "from": "node_modules/parse5/node_modules/entities", "to": "node_modules/parse5/node_modules/entities", "filter": ["**/*"] }
    ],
    "linux": {
      "target": ["deb"],
      "category": "Network",
      "icon": "desktop/icon.png",
      "syncDesktopName": true,
      "executableName": "uclv-media",
      "desktop": { "entry": { "Name": "Descargar UCLV" } }
    },
    "deb": {
      "maintainer": "Descargar UCLV <noreply@example.org>",
      "afterInstall": "desktop/linux/after-install.tpl"
    }
  }
}
